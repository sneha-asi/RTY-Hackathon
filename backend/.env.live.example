# ── Shield: live Instinct demo ────────────────────────────────────────────────
# Copy to backend/.env on YOUR LAPTOP and fill in. Never commit .env or paste it into chat.
#   cp .env.live.example .env

# 1) Owner secret: you type this to log in to the approval page (12+ characters)
SHIELD_USER_SECRET=

# 2) Accounts (Gmail addresses)
FOUNDER_TEST_GMAIL=          # the account Shield SENDS FROM (the one you sign in with for token.json)
INVESTOR_TEST_GMAIL=         # "Priya": a test recipient inbox YOU control (receives the approved email)
FOUNDER_NAME=Sneha           # signs the outgoing email

# 3) Mail mode: start with fake, switch to gmail after scripts/gmail_smoke.py passes
SHIELD_MAIL=fake             # fake | gmail
GMAIL_TOKEN=token.json       # created by: python demo/scripts/gmail_token.py --out token.json --scopes send,readonly

# 4) Watch (optional scene; off the critical path)
SHIELD_WATCH=off             # off | fake | gmail
WATCH_GMAIL_TOKEN=token_watch.json   # created by: python demo/scripts/gmail_token.py --out token_watch.json --scopes readonly,modify,compose

# 5) Leave as is
SHIELD_ENABLE_DEV=0          # 1 only for rehearsal tricks (tamper / fault injection)
SHIELD_REVIEW_BASE=http://127.0.0.1:8000
SHIELD_MCP_HOST=127.0.0.1
SHIELD_MCP_PORT=8765
SHIELD_OWNER_PORT=8000
SHIELD_TODAY=2026-11-18

# Synthetic contacts other than Priya (never emailed; leave as is)
SECOND_TEST_EMAIL=riya@acme.test
THIRD_TEST_EMAIL=ramesh@kirana.test
FOURTH_TEST_EMAIL=karan@angel.test
COFOUNDER_TEST_EMAIL=ananya@ownco.test
ACCOUNTANT_TEST_EMAIL=vikram@joshi.test
