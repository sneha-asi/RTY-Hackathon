# --- runtime ---
SHIELD_USER_SECRET=change-me                   # owner console login; the only credential that can approve
SHIELD_MAIL=fake                               # fake (sandbox) | gmail
GMAIL_TOKEN=token.json                         # SENDER test account (only Shield): gmail.send + gmail.readonly; git-ignored
# Three Google TEST accounts for the live demo (never personal accounts):
#   1. restricted demo inbox  (Instinct reads it; seeded by scripts/seed_restricted_inbox.py; token_restricted.json)
#   2. sender                 (only Shield sends from it; GMAIL_TOKEN; FOUNDER_TEST_GMAIL)
#   3. recipient              (Priya's inbox on stage; INVESTOR_TEST_GMAIL)
SHIELD_TODAY=2026-11-18
SHIELD_ENABLE_DEV=1
SHIELD_REVIEW_BASE=http://127.0.0.1:8000           # where review links point (owner listener)
SHIELD_MCP_HOST=127.0.0.1                      # MCP listener; the only port to expose to a remote client
SHIELD_MCP_PORT=8765
SHIELD_OWNER_PORT=8000                         # owner console; always 127.0.0.1, never tunnelled
ANTHROPIC_API_KEY=
